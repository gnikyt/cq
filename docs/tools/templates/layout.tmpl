{{define "header" -}}
<header class="site-header">
    <button class="icon-btn menu-btn" aria-label="Toggle navigation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a class="brand" href="index.html">
      <span class="logo">{{.Site.Short}}</span>
      <span>{{.Site.Title}}</span>
      <span class="tag">{{.Site.Version}}</span>
    </a>
    <div class="header-spacer"></div>
    <div class="header-actions">
      <a class="icon-btn" href="{{.Site.Repo}}" aria-label="GitHub repository" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.05 0-1.11.39-2.02 1.03-2.74-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.35 9.35 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.74 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
      </a>
      <button class="icon-btn theme-toggle" aria-label="Toggle dark mode">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </header>
{{- end}}

{{define "sidebar" -}}
<aside class="sidebar">
      {{range .Nav}}<nav class="nav-group">
        <h4>{{.Title}}</h4>
        <ul>
          {{range .Items}}<li><a href="{{.Href}}"{{if .Active}} class="active"{{end}}>{{.Title}}</a></li>
          {{end}}</ul>
      </nav>
      {{end}}
    </aside>
{{- end}}

{{define "page" -}}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{.Title}} — {{.Site.Short}}</title>
  <meta name="description" content="{{.Desc}}" />
  <link rel="stylesheet" href="assets/docs.css" />
</head>
<body>
  {{template "header" .}}

  <div class="backdrop"></div>

  <div class="layout">
    {{template "sidebar" .}}

    <main class="content">
      <div class="content-inner">
        <div class="breadcrumb"><a href="index.html">Documentation</a> / {{.GroupTitle}}</div>
{{.Content}}
        <div class="pager">
          {{if .Prev}}<a href="{{.Prev.Href}}"><span class="dir">← Previous</span>{{.Prev.Title}}</a>{{else}}<span></span>{{end}}
          {{if .Next}}<a class="next" href="{{.Next.Href}}"><span class="dir">Next →</span>{{.Next.Title}}</a>{{else}}<span></span>{{end}}
        </div>
      </div>
    </main>

    <aside class="toc">
      <h4>On this page</h4>
      <ul></ul>
    </aside>
  </div>

  <script src="assets/docs.js"></script>
</body>
</html>
{{- end}}

{{define "landing" -}}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{.Site.Short}} — {{.Site.Title}} documentation</title>
  <meta name="description" content="{{.Desc}}" />
  <link rel="stylesheet" href="assets/docs.css" />
</head>
<body>
  {{template "header" .}}

  <div class="backdrop"></div>

  <div class="layout">
    {{template "sidebar" .}}

    <main class="content">
      <div class="content-inner">
        <div class="breadcrumb">Documentation</div>
        <h1>Documentation</h1>
        <p class="lead">
          Complete reference documentation for <strong>{{.Site.Short}}</strong>... a lightweight,
          auto-scaling queue for processing Go functions as jobs. Keep jobs simple, then
          compose behavior with wrappers for retries, timeouts, tracing, and more.
        </p>

        <blockquote>
          <strong>New here?</strong> Start with the
          <a href="quick-start.html">Quick Start</a> for installation and a runnable
          example, then browse <a href="common-recipes.html">Common Recipes</a> for
          practical patterns.
        </blockquote>
{{range .Cards}}
        <h2>{{.Title}}</h2>
        <div class="card-grid">
          {{range .Cards}}<a class="card" href="{{.Href}}">
            <h3>{{.Title}}</h3>
            <p>{{.Blurb}}</p>
          </a>
          {{end}}</div>
{{end}}
      </div>
    </main>

    <aside class="toc">
      <h4>On this page</h4>
      <ul></ul>
    </aside>
  </div>

  <script src="assets/docs.js"></script>
</body>
</html>
{{- end}}
